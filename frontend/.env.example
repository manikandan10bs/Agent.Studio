# ====================================================================
# AGENT.STUDIO - Frontend Environment Configuration
# ====================================================================

# 1. Backend Cloud Run API URL
# Leave empty or set to /api when using Firebase Hosting rewrites to Cloud Run.
# For cross-origin direct calls, set to your Cloud Run URL:
VITE_API_BASE_URL=https://agent-studio-backend-xxxxx-uc.a.run.app/api

# 2. Firebase Client Configuration
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
