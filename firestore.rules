rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile: users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User AI Agents subcollection: users/{userId}/agents/{agentId}
      match /agents/{agentId} {
        allow read, write: if isOwner(userId);
      }

      // User Workflows subcollection: users/{userId}/workflows/{workflowId}
      match /workflows/{workflowId} {
        allow read, write: if isOwner(userId);
      }

      // User Execution History subcollection: users/{userId}/executions/{executionId}
      match /executions/{executionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public Gallery Agents: public_agents/{agentId}
    match /public_agents/{agentId} {
      // Allow public exploration and testing
      allow read: if true;
      // Only authenticated creators can publish / manage public entries
      allow write: if isAuthenticated();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
