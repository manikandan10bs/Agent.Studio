# ====================================================================
# AGENT.STUDIO Configuration
# ====================================================================

# Security & Authentication
SECRET_KEY=agent-studio-super-secret-jwt-key-2026-production-ready
ENCRYPTION_MASTER_KEY=agent-studio-master-encryption-key-32-chars!!
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INVITATION_TOKEN_EXPIRE_HOURS=72

# Database
# Production (PostgreSQL + pgvector):
# DATABASE_URL=postgresql://agent_admin:password@localhost:5432/agent_studio
# Local Development Fallback (Zero external dependencies):
DATABASE_URL=sqlite:///./agent_studio.db

# Initial Super Administrator Credentials
DEFAULT_ADMIN_EMAIL=admin@agent.studio
DEFAULT_ADMIN_PASSWORD=Admin@Studio2026
DEFAULT_ADMIN_NAME=Platform Administrator

# Upload Storage Directory
STORAGE_DIR=./uploads

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# ====================================================================
# LLM Provider API Keys
# You can paste your API keys below OR add them in the UI at /admin
# ====================================================================
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
