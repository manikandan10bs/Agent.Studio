# ====================================================================
# AGENT.STUDIO - Environment Configuration Template
# ====================================================================

# 1. Security & Authentication (Required)
SECRET_KEY=agent-studio-super-secret-jwt-key-2026-production-ready
ENCRYPTION_MASTER_KEY=agent-studio-master-encryption-key-32-chars!!
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INVITATION_TOKEN_EXPIRE_HOURS=72

# 2. Database (Required for Production Persistence on Free-Tier)
# Supabase PostgreSQL (Free Tier):
# Copy your connection string from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Local SQLite Fallback:
# DATABASE_URL=sqlite:///./agent_studio.db

# 3. Frontend Production URL (For CORS on Render backend)
FRONTEND_URL=https://your-agent-studio.vercel.app

# 4. Supabase Storage (Optional - For persistent raw uploaded files)
# Find in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=agent-documents

# 5. Initial Super Administrator (Created on first run)
DEFAULT_ADMIN_EMAIL=admin@agent.studio
DEFAULT_ADMIN_PASSWORD=Admin@Studio2026
DEFAULT_ADMIN_NAME=Platform Administrator

# 6. Upload Storage Directory (Local fallback)
STORAGE_DIR=./uploads

# 7. LLM Provider API Keys (Managed securely via backend env or /admin UI)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
