# ====================================================================
# AGENT.STUDIO - Backend Environment Configuration Template
# ====================================================================

# 1. Server & Port Configuration (Cloud Run sets PORT automatically to 8080)
PORT=8080
PYTHONUNBUFFERED=1

# 2. Security & Encryption Keys
SECRET_KEY=agent-studio-super-secret-jwt-key-2026-production-ready
ENCRYPTION_MASTER_KEY=agent-studio-master-encryption-key-32-chars!!
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INVITATION_TOKEN_EXPIRE_HOURS=72

# 3. Google Cloud & Firebase Configuration
# If deployed on Google Cloud Run with IAM service account, authentication is automatic.
# For local development or non-GCP hosting, provide project ID and credentials.
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_CLOUD_PROJECT=your-firebase-project-id
# Path to service account JSON (optional on Cloud Run):
# FIREBASE_CREDENTIALS_PATH=./service-account.json
# Or inline JSON string:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
USE_FIRESTORE=true

# 4. CORS Origins (comma-separated list of allowed frontend URLs)
CORS_ORIGINS=https://your-firebase-project-id.web.app,https://your-firebase-project-id.firebaseapp.com,http://localhost:5173
FRONTEND_URL=https://your-firebase-project-id.web.app

# 5. Database (PostgreSQL on Cloud SQL / Supabase or SQLite fallback)
DATABASE_URL=sqlite:///./agent_studio.db

# 6. Upload Storage Directory
STORAGE_DIR=./uploads

# 7. Initial Super Administrator (Created on first run)
DEFAULT_ADMIN_EMAIL=admin@agent.studio
DEFAULT_ADMIN_PASSWORD=Admin@Studio2026
DEFAULT_ADMIN_NAME=Platform Administrator

# 8. LLM Provider API Keys (Or configure via Google Cloud Secret Manager)
# Cloud Run automatically retrieves secrets if named GEMINI_API_KEY in Secret Manager
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
